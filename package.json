{
	"name": "foliospindle-proof",
	"version": "0.1.0",
	"description": "Pre-application proof of single-file WASM packaging, direct indexer authorization, fixture round trip and object event observation.",
	"type": "module",
	"license": "MIT",
	"author": "Ojus Chugh",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --import ./tests/preload.ts --test \"tests/**/*.test.ts\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check:artifact": "node scripts/check-artifact.mjs",
		"check:reproducible": "node scripts/check-reproducible.mjs",
		"check:boundary": "node scripts/boundary-check.mjs",
		"check:repo": "node scripts/check-repo.mjs",
		"check:fixtures": "node scripts/check-fixtures.mjs",
		"check:comments": "node scripts/check-comments.mjs",
		"check:text": "node scripts/check-text.mjs",
		"check:commits": "node scripts/check-commits.mjs"
	},
	"dependencies": {
		"@siafoundation/sia-storage": "0.1.1"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "24.19.1",
		"builtin-modules": "5.4.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "1.11.4",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0"
	}
}
